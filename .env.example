# ─── Gemini AI (server-side only — never in browser bundle) ──────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Coupon codes (server-side only, comma-separated) ────────────
# Add as many as you need. Share with hackathon judges / partners.
COUPON_CODES=JUDGE2026,DEMO2026,CEAL100

# ─── Supabase (client-safe, VITE_ prefix) ────────────────────────
# Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── PayPal (client-safe, VITE_ prefix) ──────────────────────────
# developer.paypal.com → My Apps → your app → Client ID
# Use Sandbox ID for testing, Live ID for production
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ─── App URL ─────────────────────────────────────────────────────
APP_URL=https://your-cloudrun-url.run.app

# ─── Supabase Table (run once in Supabase SQL Editor) ────────────
# CREATE TABLE login_events (
#   id              uuid DEFAULT gen_random_uuid() PRIMARY KEY,
#   name            text NOT NULL,
#   email           text NOT NULL,
#   tier            text NOT NULL,
#   amount_inr      integer,
#   paypal_order_id text,
#   coupon_used     text,
#   access_type     text NOT NULL,   -- 'paid' | 'coupon'
#   logged_at       timestamptz DEFAULT now()
# );

# ─── Local dev ───────────────────────────────────────────────────
# Terminal 1: npm run server   (Express on :8080)
# Terminal 2: npm run dev      (Vite on :3000, proxies /api → :8080)

# ─── Cloud Run deploy ─────────────────────────────────────────────
# gcloud builds submit --tag gcr.io/PROJECT_ID/ceal-lead \
#   --build-arg VITE_SUPABASE_URL=... \
#   --build-arg VITE_SUPABASE_ANON_KEY=... \
#   --build-arg VITE_PAYPAL_CLIENT_ID=...
#
# gcloud run deploy ceal-lead \
#   --image gcr.io/PROJECT_ID/ceal-lead \
#   --platform managed \
#   --region us-central1 \
#   --allow-unauthenticated \
#   --set-env-vars GEMINI_API_KEY=...,COUPON_CODES=JUDGE2026,DEMO2026

# ─── Admin Panel ─────────────────────────────────────────────────
# Accessible at: https://your-url.run.app/admin
ADMIN_EMAIL=kanchan.g12@gmail.com
ADMIN_PASSWORD=Admin@7890

# ─── Supabase Service Role Key (server-side only) ─────────────────
# Settings → API → service_role key — gives full DB read access for admin
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
